APP_NAME="Emplea Local"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

# Acceso rápido a las cuentas de prueba en el login (solo desarrollo; nunca en producción)
DEMO_ACCOUNTS_ENABLED=false

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# WebSockets en tiempo real (Laravel Reverb). Ejecuta "php artisan reverb:start"
# en otra terminal y "npm run dev" (o "npm run build") para el frontend.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=emplea-local
REVERB_APP_KEY=cambia-esta-clave
REVERB_APP_SECRET=cambia-este-secreto
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ---------------------------------------------------------------------------
# Docker (opcional)
# ---------------------------------------------------------------------------
# Valores usados por docker-compose.yml para publicar los servicios y
# compilar el frontend. No son secretos: las credenciales reales se toman de
# las variables REVERB_APP_KEY / REVERB_APP_SECRET de este mismo archivo y
# nunca se guardan en la imagen ni en el repositorio.
#
# DOCKER_HTTP_PORT=8000
# DOCKER_APP_URL=http://localhost:8000
# DOCKER_APP_ENV=local
# DOCKER_APP_DEBUG=true
# DOCKER_REVERB_HOST=localhost
# DOCKER_REVERB_PORT=8080
# DOCKER_REVERB_SCHEME=http
# DOCKER_SANCTUM_DOMAINS=localhost:8000,127.0.0.1:8000
# DOCKER_SEED_ON_FIRST_RUN=true
#
# La imagen Docker se construye sin .env y sin database/database.sqlite:
# ambos se montan en tiempo de ejecución. Si APP_KEY está vacía, el
# entrypoint genera una automáticamente en este archivo local.

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo saliente (Gmail SMTP). Completa MAIL_USERNAME y MAIL_PASSWORD en tu
# .env local (que NO se versiona) con tu dirección de Gmail y una contraseña de
# aplicación de Google de 16 caracteres. Nunca uses tu contraseña personal ni
# subas credenciales reales a este archivo de ejemplo.
#
# Laravel 12 usa MAIL_SCHEME en lugar de MAIL_ENCRYPTION. Con el puerto 587 deja
# MAIL_SCHEME=null: Symfony negocia STARTTLS automáticamente (equivale a
# MAIL_ENCRYPTION=tls). Para TLS implícito usa MAIL_SCHEME=smtps y MAIL_PORT=465.
# Sin credenciales puedes poner MAIL_MAILER=log y revisar storage/logs/laravel.log.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME="tucorreo@gmail.com"
MAIL_PASSWORD="xxxxxxxxxxxxxxxx"
MAIL_TIMEOUT=15
MAIL_FROM_ADDRESS="tucorreo@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
